{
  "DropShield": {
    "Enabled": true,
    "StateProvider": "InMemory",
    "OriginBaseUrl": "http://localhost:5058",
    "OriginTimeoutSeconds": 10,
    "ProtectedProducts": [
      "pokemon-etb"
    ],
    "SyntheticClientIdentity": {
      "Enabled": false,
      "HeaderName": "X-DropShield-Test-Client"
    },
    "InternalMetrics": {
      "Enabled": false
    },
    "Redis": {
      "ConnectionString": "127.0.0.1:6379",
      "Database": 0,
      "KeyPrefix": "dropshield:v1",
      "IdentityHashKey": "",
      "ConnectTimeoutMilliseconds": 1000,
      "OperationTimeoutMilliseconds": 1000
    },
    "Admission": {
      "Enabled": true,
      "ProtectedProduct": "pokemon-etb",
      "MaximumActiveSessions": 200,
      "AdmissionBatchSize": 20,
      "MaximumWaitingSessions": 2000,
      "SessionTtlSeconds": 300,
      "WaitingTtlSeconds": 600,
      "RetryAfterSeconds": 5
    },
    "Policies": {
      "Stock": {
        "Enabled": true,
        "ClientPermitLimit": 5,
        "ClientWindowSeconds": 1,
        "AggregatePermitLimit": 200,
        "AggregateWindowSeconds": 1
      },
      "Cart": {
        "Enabled": true,
        "ClientPermitLimit": 2,
        "ClientWindowSeconds": 1
      },
      "Checkout": {
        "Enabled": true,
        "ClientPermitLimit": 1,
        "ClientWindowSeconds": 5
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
