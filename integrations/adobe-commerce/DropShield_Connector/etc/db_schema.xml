<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="dropshield_protected_drop" resource="default" engine="innodb" comment="DropShield protected drops">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="varchar" name="drop_identifier" nullable="false" length="64" comment="Stable DropShield drop identifier"/>
        <column xsi:type="varchar" name="name" nullable="false" length="255" comment="Operator name"/>
        <column xsi:type="smallint" name="is_enabled" nullable="false" default="0" comment="Enabled"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false" comment="Created at"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated at"/>
        <constraint xsi:type="primary" referenceId="PRIMARY"><column name="entity_id"/></constraint>
        <constraint xsi:type="unique" referenceId="DROPSHIELD_PROTECTED_DROP_IDENTIFIER_UNQ"><column name="drop_identifier"/></constraint>
        <index referenceId="DROPSHIELD_PROTECTED_DROP_ENABLED_IDX" indexType="btree"><column name="is_enabled"/></index>
    </table>
    <table name="dropshield_protected_drop_product" resource="default" engine="innodb" comment="DropShield protected drop product assignments">
        <column xsi:type="int" name="drop_id" unsigned="true" nullable="false" comment="Drop ID"/>
        <column xsi:type="int" name="product_id" unsigned="true" nullable="false" comment="Magento product entity ID"/>
        <constraint xsi:type="primary" referenceId="PRIMARY"><column name="drop_id"/><column name="product_id"/></constraint>
        <constraint xsi:type="foreign" referenceId="DROPSHIELD_DROP_PRODUCT_DROP_FK" table="dropshield_protected_drop_product" column="drop_id" referenceTable="dropshield_protected_drop" referenceColumn="entity_id" onDelete="CASCADE"/>
        <constraint xsi:type="foreign" referenceId="DROPSHIELD_DROP_PRODUCT_CATALOG_FK" table="dropshield_protected_drop_product" column="product_id" referenceTable="catalog_product_entity" referenceColumn="entity_id" onDelete="CASCADE"/>
        <index referenceId="DROPSHIELD_DROP_PRODUCT_PRODUCT_IDX" indexType="btree"><column name="product_id"/></index>
    </table>
    <table name="dropshield_protected_drop_lock" resource="default" engine="innodb" comment="DropShield enabled drop lock">
        <column xsi:type="smallint" name="lock_id" unsigned="true" nullable="false" comment="Lock ID"/>
        <constraint xsi:type="primary" referenceId="PRIMARY"><column name="lock_id"/></constraint>
    </table>
</schema>
