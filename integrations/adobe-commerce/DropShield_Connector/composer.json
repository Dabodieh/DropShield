{
    "name": "dropshield/connector",
    "description": "Thin Adobe Commerce / Magento 2 connector that enforces DropShield origin assertions on protected cart and checkout operations.",
    "type": "magento2-module",
    "license": "MIT",
    "require": {
        "php": "~8.1.0||~8.2.0||~8.3.0",
        "magento/framework": "^103.0",
        "magento/module-quote": "^101.0",
        "magento/module-checkout": "^100.4",
        "magento/module-store": "^101.1",
        "magento/module-catalog": "^104.0",
        "magento/module-backend": "^102.0",
        "magento/module-webapi": "^100.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "DropShield\\Connector\\": ""
        }
    }
}
