{
  "DropShield": {
    "Enabled": true,
    "OriginBaseUrl": "http://localhost:5058",
    "OriginTimeoutSeconds": 10,
    "ProtectedProducts": [
      "pokemon-etb"
    ],
    "SyntheticClientIdentity": {
      "Enabled": false,
      "HeaderName": "X-DropShield-Test-Client"
    },
    "InternalMetrics": {
      "Enabled": false
    },
    "Policies": {
      "Stock": {
        "Enabled": true,
        "ClientPermitLimit": 5,
        "ClientWindowSeconds": 1,
        "AggregatePermitLimit": 200,
        "AggregateWindowSeconds": 1
      },
      "Cart": {
        "Enabled": true,
        "ClientPermitLimit": 2,
        "ClientWindowSeconds": 1
      },
      "Checkout": {
        "Enabled": true,
        "ClientPermitLimit": 1,
        "ClientWindowSeconds": 5
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
